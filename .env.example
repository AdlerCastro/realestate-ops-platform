# Caminho absoluto (ou relativo à raiz do projeto) para o arquivo
# cambara_teste_tecnico.db. Nunca hardcoded no código.
DATABASE_PATH=data/cambara_teste_tecnico.db

# Segredo usado para assinar o cookie de sessão (ver lib/features/auth).
# Gere um valor aleatório, ex.: openssl rand -base64 32
SESSION_SECRET=

# Usado pelo assistente de linguagem natural (lib/features/assistente).
# Duas chamadas por pergunta: openai/gpt-oss-120b (texto -> SQL) e
# openai/gpt-oss-20b (resultado -> resposta em português). Gere em
# https://console.groq.com/keys.
GROQ_API_KEY=
